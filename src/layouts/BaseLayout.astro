---
import Analytics from '../components/Analytics.astro';
import SiteEffects from '../components/SiteEffects.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import lenisCss from 'lenis/dist/lenis.css?inline';

interface Props {
  title?: string;
  description?: string;
  effects?: boolean;
}

const {
  title = 'Ben Kurian',
  description = 'Portfolio of Ben Kurian — documentary filmmaker, healthcare advocate, and musician based in Columbus, Ohio.',
  effects = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {isHomePage && <link rel="preload" href="/images/hero.jpg" as="image" />}
    <link rel="preload" href="/fonts/helvetica-neue/HelveticaNeue-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/helvetica-neue/HelveticaNeue-Bold.woff2" as="font" type="font/woff2" crossorigin />
    {effects && <style is:global set:html={lenisCss} />}
    <style is:inline>
      html.page-entering body { opacity: 0; }
    </style>
    <script is:inline>
      (function() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReducedMotion && sessionStorage.getItem('page-transition')) {
          document.documentElement.classList.add('page-entering');
        }
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <slot />
    {effects && <SiteEffects />}
  </body>
</html>
