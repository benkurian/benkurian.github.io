---
import { getAllCards } from '../data/site';
import type { ModalLinkItem, ModalLinkSection } from '../types/site';

const cards = getAllCards();

const actionLabels: Record<ModalLinkItem['action'], string> = {
  listen: 'Listen',
  watch: 'Watch',
  read: 'Read',
  view: 'View Score',
};

function renderLinkSection(section: ModalLinkSection) {
  return `
    <section class="modal-link-section">
      <h4>${section.heading}</h4>
      <ul class="score-list">
        ${section.items
          .map(
            (item) => `
        <li class="score-item">
          <div class="score-info">
            <span class="yr">${item.meta}</span>
            <em>${item.title}</em>
            <small>${item.detail}</small>
          </div>
          <a href="${item.url}" class="score-btn" target="_blank" rel="noopener">${actionLabels[item.action]}</a>
        </li>`,
          )
          .join('')}
      </ul>
    </section>`;
}

function renderLinkSections(sections: ModalLinkSection[]) {
  return sections.map(renderLinkSection).join('');
}
---

<div class="modal-overlay" id="modalOverlay"></div>
<div class="modal-container" id="modalContainer">
  <div class="modal-close"><button type="button" id="modalCloseBtn">&times;</button></div>
  <div class="modal-body" id="modalBody"></div>
</div>

{
  cards.map((card) => (
    <template id={`modal-${card.id}`}>
      <div class="modal-label">{card.modal.label}</div>
      <h2 class="modal-title">{card.modal.title}</h2>
      <div class="modal-meta">{card.modal.meta}</div>
      <div class="modal-content" set:html={card.modal.content} />
      {card.modal.linkSections && <div set:html={renderLinkSections(card.modal.linkSections)} />}
    </template>
  ))
}

<button class="back-to-top" id="backToTop" aria-label="Back to top">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M12 19V5m0 0l-6 6m6-6l6 6"></path>
  </svg>
</button>

<script>
  const overlay = document.getElementById('modalOverlay');
  const container = document.getElementById('modalContainer');
  const body = document.getElementById('modalBody');
  const closeBtn = document.getElementById('modalCloseBtn');

  function openModal(id: string) {
    const template = document.getElementById(`modal-${id}`) as HTMLTemplateElement | null;
    if (!template || !body || !overlay || !container) return;

    body.replaceChildren(...template.content.cloneNode(true).childNodes);
    overlay.classList.add('active');
    container.classList.add('active');
    document.body.style.overflow = 'hidden';
    container.scrollTop = 0;
  }

  function closeModal() {
    overlay?.classList.remove('active');
    container?.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', closeModal);
  container?.addEventListener('click', (e) => e.stopPropagation());

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.card[data-modal]') as HTMLElement | null;
    if (card?.dataset.modal) openModal(card.dataset.modal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const card = (e.target as HTMLElement).closest('.card[data-modal]') as HTMLElement | null;
    if (card?.dataset.modal) openModal(card.dataset.modal);
  });
</script>
