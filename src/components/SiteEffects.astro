<script>
  import Lenis from 'lenis';

  const rootStyles = getComputedStyle(document.documentElement);
  const navHeight = parseInt(rootStyles.getPropertyValue('--nav-height'), 10) || 44;
  const scrollDurationMin = parseFloat(rootStyles.getPropertyValue('--scroll-duration')) || 1.8;
  const scrollDurationMax = parseFloat(rootStyles.getPropertyValue('--scroll-duration-max')) || 2.4;
  const scrollEase = (t: number) => 1 - (1 - t) ** 4;

  function scrollDurationFor(target: HTMLElement) {
    const top = target.getBoundingClientRect().top + window.scrollY - navHeight;
    const distance = Math.abs(top - window.scrollY);
    const scaled = distance / 900 + scrollDurationMin;
    return Math.min(scrollDurationMax, Math.max(scrollDurationMin, scaled));
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pageTransitionMs =
    (parseFloat(rootStyles.getPropertyValue('--page-transition-duration')) || 0.3) * 1000;
  const pageTransitionKey = 'page-transition';

  function resetPageTransitionState() {
    document.documentElement.classList.remove('page-entering', 'page-enter', 'page-leaving');
    document.body.style.opacity = '';
    sessionStorage.removeItem(pageTransitionKey);
  }

  window.addEventListener('pageshow', resetPageTransitionState);
  window.addEventListener('pagehide', () => {
    document.documentElement.classList.remove('page-leaving');
  });

  const isHomePage =
    window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');

  function runPageEnter() {
    requestAnimationFrame(() => {
      document.documentElement.classList.remove('page-entering');
      document.documentElement.classList.add('page-enter');

      window.setTimeout(() => {
        document.documentElement.classList.remove('page-enter');
      }, pageTransitionMs);
    });
  }

  if (!prefersReducedMotion && sessionStorage.getItem(pageTransitionKey)) {
    sessionStorage.removeItem(pageTransitionKey);
    runPageEnter();
  }

  let lenis: Lenis | null = null;

  if (!prefersReducedMotion && isHomePage) {
    lenis = new Lenis({
      lerp: 0.09,
      smoothWheel: true,
      wheelMultiplier: 0.9,
    });

    function raf(time: number) {
      lenis?.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
  }

  function navigateWithTransition(url: string) {
    sessionStorage.setItem(pageTransitionKey, '1');
    document.documentElement.classList.add('page-leaving');

    requestAnimationFrame(() => {
      window.setTimeout(() => {
        window.location.assign(url);
      }, pageTransitionMs);
    });
  }

  document.addEventListener('click', (event) => {
    if (prefersReducedMotion || event.defaultPrevented) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = (event.target as Element).closest('a');
    if (!(link instanceof HTMLAnchorElement)) return;
    if (link.target === '_blank' || link.hasAttribute('download')) return;

    const href = link.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;

    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin || url.href === window.location.href) return;

    const isPageTransition =
      link.classList.contains('panel') ||
      link.classList.contains('work-back') ||
      link.classList.contains('work-pagination-link') ||
      link.classList.contains('notfound-back') ||
      link.classList.contains('masthead-brand');

    if (!isPageTransition) return;

    event.preventDefault();
    navigateWithTransition(url.href);
  });

  function hashFromHref(href: string | null) {
    if (!href || href === '#') return null;
    if (href.startsWith('/#')) return href.slice(1);
    if (href.startsWith('#')) return href;
    return null;
  }

  document
    .querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]')
    .forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const hash = hashFromHref(anchor.getAttribute('href'));
        if (!hash) return;

        if (anchor.getAttribute('href')?.startsWith('/#') && !isHomePage) return;

        const target = document.querySelector(hash);
        if (!target) return;

        event.preventDefault();

        if (lenis) {
          lenis.scrollTo(target, {
            offset: -navHeight,
            duration: scrollDurationFor(target as HTMLElement),
            easing: scrollEase,
          });
        } else {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.masthead-nav a[data-section]');
  const sections = [...navLinks]
    .map((link) => {
      const id = link.getAttribute('data-section');
      const el = id ? document.getElementById(id) : null;
      return el ? { el, link } : null;
    })
    .filter(Boolean) as { el: HTMLElement; link: HTMLAnchorElement }[];

  function getScrollY() {
    return lenis ? lenis.scroll : window.scrollY;
  }

  function updateActiveNav() {
    if (!sections.length) return;

    const scrollY = getScrollY();
    const viewportEnd = scrollY + window.innerHeight;
    const pageEnd = document.documentElement.scrollHeight;
    const marker = scrollY + navHeight + 96;

    let active = sections[0];

    if (viewportEnd >= pageEnd - 48) {
      active = sections[sections.length - 1];
    } else {
      for (const section of sections) {
        const top = section.el.getBoundingClientRect().top + scrollY;
        if (top <= marker) active = section;
      }
    }

    navLinks.forEach((l) => l.classList.remove('active'));
    active.link.classList.add('active');
  }

  if (sections.length) {
    if (lenis) lenis.on('scroll', updateActiveNav);
    else window.addEventListener('scroll', updateActiveNav, { passive: true });

    window.addEventListener('resize', updateActiveNav);
    updateActiveNav();
  }
</script>
