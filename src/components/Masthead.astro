---
import { SITE_DATA } from '../data/site';

const navSections = SITE_DATA.sections;
const resumeUrl = SITE_DATA.resumeUrl;
---

<header class="masthead page-shell">
  <div class="masthead-inner">
    <a href="/" class="masthead-brand">Ben Kurian</a>
    <nav>
      <ul class="masthead-nav" id="navList">
        <li><a href="/#about" data-section="about">About</a></li>
        {
          navSections.map((section) => (
            <li>
              <a href={`/#${section.id}`} data-section={section.id}>
                {section.title}
              </a>
            </li>
          ))
        }
        {
          resumeUrl && (
            <li>
              <a href={resumeUrl} target="_blank" rel="noopener noreferrer">
                Résumé
              </a>
            </li>
          )
        }
      </ul>
    </nav>
    <button class="hamburger" id="hamburgerBtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobileNav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav class="mobile-nav" id="mobileNav">
  <a href="/#about">About</a>
  {navSections.map((section) => <a href={`/#${section.id}`}>{section.title}</a>)}
  {resumeUrl && <a href={resumeUrl} target="_blank" rel="noopener noreferrer">Résumé</a>}
</nav>

<script>
  const btn = document.getElementById('hamburgerBtn');
  const nav = document.getElementById('mobileNav');
  const rootStyles = getComputedStyle(document.documentElement);
  const menuTransitionMs =
    (parseFloat(rootStyles.getPropertyValue('--menu-transition-duration')) || 0.32) * 1000;

  function setMenuOpen(isOpen: boolean) {
    btn?.classList.toggle('active', isOpen);
    nav?.classList.toggle('open', isOpen);
    btn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  function closeMobileNav() {
    setMenuOpen(false);
  }

  btn?.addEventListener('click', () => {
    setMenuOpen(!nav?.classList.contains('open'));
  });

  nav?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (!(link instanceof HTMLAnchorElement)) return;

    if (link.target === '_blank') {
      closeMobileNav();
      return;
    }

    const href = link.getAttribute('href');
    if (!href || href.startsWith('mailto:') || href.startsWith('tel:')) {
      closeMobileNav();
      return;
    }

    e.preventDefault();
    closeMobileNav();

    const isHomePage =
      window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');
    const hash = href.startsWith('/#') ? href.slice(1) : href.startsWith('#') ? href : null;

    window.setTimeout(() => {
      if (hash && isHomePage) {
        const target = document.querySelector(hash);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
      }
      window.location.assign(link.href);
    }, menuTransitionMs);
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('a[href$=".pdf"]').forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture('resume_viewed');
      });
    });
  });
</script>
