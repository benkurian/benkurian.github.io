---
import type { SiteData } from '../types/site';

interface Props {
  hero: SiteData['hero'];
}

const { hero } = Astro.props;
---

<section class="hero page-shell">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1 class="hero-name">
        {
          hero.name.map((line, i) => (
            <span class={i === hero.name.length - 1 ? 'hero-name-strong' : 'hero-name-light'}>
              {line}
            </span>
          ))
        }
      </h1>
      {hero.subtitle && <p class="hero-subtitle">{hero.subtitle}</p>}
    </div>
    {
      hero.bgImage && (
        <figure class="hero-figure">
          <img src={hero.bgImage} alt="" width="640" height="800" />
        </figure>
      )
    }
  </div>
</section>
