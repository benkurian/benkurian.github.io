---
import type { Section } from '../types/site';
import Card from './Card.astro';

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

<section class="section page-shell" id={section.id}>
  <h2 class="section-title">{section.title}</h2>
  <div class="panel-grid" data-layout={section.layout}>
    {section.cards.map((card) => <Card card={card} sectionId={section.id} />)}
  </div>
</section>
