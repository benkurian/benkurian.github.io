---
import type { SiteData } from '../types/site';

interface Props {
  about: SiteData['about'];
}

const { about } = Astro.props;
---

<section class="page-shell" id="about">
  <div class="about-inner">
    <div class="about-text-col">
      <p class="about-lead">{about.heading}</p>
      {about.paragraphs.map((paragraph) => <p class="about-text" set:html={paragraph} />)}
    </div>
    {
      about.photo && (
        <figure class="about-photo">
          <img src={about.photo} alt="Ben Kurian" />
        </figure>
      )
    }
  </div>
</section>
