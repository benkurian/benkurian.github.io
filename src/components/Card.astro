---
import type { Card } from '../types/site';

interface Props {
  card: Card;
  sectionId: string;
}

const { card, sectionId } = Astro.props;
---

<a href={`/${sectionId}/${card.id}/`} class="panel">
  {
    card.bgImage && (
      <div class="panel-media">
        <img src={card.bgImage} alt="" loading="lazy" />
      </div>
    )
  }
  <p class="panel-caption">
    <span class="panel-title">{card.title}</span>
    {card.label && <span class="panel-meta">{card.label}</span>}
  </p>
</a>
