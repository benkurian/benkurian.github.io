---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
---

<BaseLayout title="Page Not Found — Ben Kurian" description="The page you’re looking for doesn’t exist.">
  <Masthead />
  <section class="notfound page-shell">
    <div class="notfound-inner">
      <p class="notfound-code">404</p>
      <h1 class="notfound-title">Page not found</h1>
      <p class="notfound-desc">This page has moved, or never existed.</p>
      <a href="/" class="notfound-back">Back home</a>
    </div>
  </section>
</BaseLayout>
