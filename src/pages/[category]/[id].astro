---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import WorkLinkSections from '../../components/WorkLinkSections.astro';
import { getAllCardEntries } from '../../data/site';

export function getStaticPaths() {
  return getAllCardEntries().map(({ sectionId, card }) => ({
    params: { category: sectionId, id: card.id },
    props: { card },
  }));
}

const { card } = Astro.props;
const pageTitle = `${card.detail.title} — Ben Kurian`;
---

<BaseLayout title={pageTitle} description={card.desc}>
  <Masthead />
  <article class="work-page page-shell">
    <div class="work-body">
      <a href="/" class="work-back">Back</a>

      <header class="work-header">
        {card.detail.label && <p class="work-label">{card.detail.label}</p>}
        <h1 class="work-title">{card.detail.title}</h1>
        {card.detail.meta && <p class="work-meta">{card.detail.meta}</p>}
      </header>

      <div class="work-content" set:html={card.detail.content} />
      {card.detail.linkSections && <WorkLinkSections sections={card.detail.linkSections} />}
    </div>
  </article>
</BaseLayout>
